{
  "name": "arvyra-streetwear",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ARVYRA streetwear storefront preview with a ghost mannequin 3D viewer",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsx scripts/check-catalogue.ts && npm run typecheck && npm test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
